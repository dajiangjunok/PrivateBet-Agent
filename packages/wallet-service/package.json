{
  "name": "@privatebet/wallet-service",
  "version": "0.1.0",
  "private": true,
  "description": "MPC wallet service for PrivateBet Agent",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "@privatebet/shared": "workspace:*",
    "ethers": "^6.16.0"
  },
  "devDependencies": {
    "typescript": "^5.7.2"
  }
}
