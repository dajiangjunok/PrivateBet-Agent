{
  "name": "@privatebet/privacy-layer",
  "version": "0.1.0",
  "private": true,
  "description": "ZAMA FHE (fully homomorphic encryption) integration for private bets",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "@privatebet/shared": "workspace:*",
    "@zama-fhe/relayer-sdk": "^0.4.3",
    "ethers": "^6.16.0",
    "fhevmjs": "^0.6.2"
  },
  "devDependencies": {
    "typescript": "^5.7.2"
  }
}
